# Copy this file to .env and fill in real values if you need anything other
# than the defaults below. .env is gitignored and must never be committed.
#
# Every variable here already has a safe local default baked into
# application.properties and docker-compose.yml, matching each other, so
# local development works with no .env file at all. Set these explicitly
# only to override a default, or when configuring a real deployment.

# Server
PORT=8080

# Database (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finora
DB_USERNAME=finora
DB_PASSWORD=finora
